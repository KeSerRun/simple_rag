# API 密钥配置
# 优先级: 系统环境变量 > .env > config.ini
# 复制此文件为 .env（不要提交到 git）

# Chat 端（DeepSeek / OpenAI 等）
OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com

# Embedding 端（SiliconFlow 等，留空则回退到 Chat 端）
OPENAI_EMBEDDING_API_KEY=sk-xxx
# OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# MinerU PDF 解析
# MINERU_API_KEY=eyJxxx
# MINERU_BASE_URL=https://mineru.net/api/v4

# JWT 密钥（如不设置会自动生成）
# JWT_SECRET_KEY=
