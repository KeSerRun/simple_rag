# API 密钥配置
# 优先级: 系统环境变量 > .env > config.ini
# 复制此文件为 .env 后填入你的密钥（不要将 .env 提交到 git）

# ===== Chat / LLM 端 =====
# 对话模型的 API Key（支持 OpenAI 兼容接口）
# 对应 config.ini 中的 [api] chat_api_key
OPENAI_API_KEY=your-chat-api-key-here
# 对话模型 API 入口地址
# 对应 config.ini 中的 [api] chat_base_url
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# ===== Embedding 端 =====
# Embedding 模型的 API Key（留空则回退使用 OPENAI_API_KEY）
# 对应 config.ini 中的 [api] embedding_api_key
OPENAI_EMBEDDING_API_KEY=your-embedding-api-key-here
# Embedding 模型 API 地址（留空则回退使用 OPENAI_BASE_URL）
# 对应 config.ini 中的 [api] embedding_base_url
OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ===== MinerU（PDF 解析服务） =====
# MinerU 文档解析服务的 API Key
# 对应 config.ini 中的 [api] mineru_api_key
MINERU_API_KEY=your-mineru-api-key-here
# MinerU 服务 API 地址
# 对应 config.ini 中的 [api] mineru_base_url
MINERU_BASE_URL=https://mineru.net/api/v4

# ===== JWT 密钥（会话认证用） =====
# 用于签发登录 session token 的密钥
# 留空时服务启动会自动生成并回写到此文件
# 更换会导致所有已登录用户需要重新登录
JWT_SECRET_KEY=
